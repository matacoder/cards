{
  "name": "cards",
  "productName": "Cards",
  "version": "0.1.0",
  "description": "Pop-up flashcards for learning words while you work",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "app.cards.desktop",
    "files": [
      "src/**/*",
      "data/dicts/*.json",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": "dmg",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  }
}
